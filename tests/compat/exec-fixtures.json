{
  "schema_version": 1,
  "description": "npx (npm 11) versus `oath x`: each case runs in a fresh HOME for both tools and must produce the same exit code and the same normalized stdout. Oath prints its own messages on stderr. Versions are pinned so the comparison is stable; `repeat` runs a case twice to cover the warm cache; `optional` cases are reported but do not gate. Arguments avoid cmd.exe metacharacters such as `^`, which npm's script-shell layer strips on Windows and Oath does not.",
  "cases": [
    { "id": "cowsay-hello", "args": ["cowsay@1.6.0", "hello", "world"] },
    { "id": "cowsay-warm-cache", "args": ["cowsay@1.6.0", "warm"], "repeat": 2 },
    { "id": "cowsay-name-only-latest", "args": ["cowsay", "latest-tag"] },
    { "id": "cowthink-via-package", "args": ["-p", "cowsay@1.6.0", "cowthink", "moo"] },
    { "id": "two-packages", "args": ["-p", "cowsay@1.6.0", "-p", "mkdirp@3.0.1", "-c", "cowsay two && mkdirp --version"] },
    { "id": "typescript-ambiguous-bin", "args": ["typescript@5.9.3", "--version"], "compare": "status" },
    { "id": "tsc-version", "args": ["-p", "typescript@5.9.3", "tsc", "--version"] },
    { "id": "prettier-version", "args": ["prettier@3.7.4", "--version"] },
    { "id": "eslint-version", "args": ["eslint@9.39.1", "--version"] },
    { "id": "vite-version", "args": ["vite@7.1.5", "--version"] },
    { "id": "esbuild-version", "args": ["esbuild@0.25.12", "--version"] },
    { "id": "biome-scoped-version", "args": ["@biomejs/biome@2.3.4", "--version"] },
    { "id": "semver-range-match", "args": ["semver@7.7.2", "-r", "1.x", "1.2.3"] },
    { "id": "semver-no-match-exit-code", "args": ["-p", "semver@7.7.2", "semver", "-r", "2.x", "1.2.3"] },
    { "id": "mkdirp-version", "args": ["mkdirp@3.0.1", "--version"] },
    { "id": "json5-version", "args": ["json5@2.2.3", "--version"] },
    { "id": "tsx-version", "args": ["tsx@4.20.6", "--version"] },
    { "id": "http-server-version", "args": ["http-server@14.1.1", "--version"] },
    { "id": "nodemon-version", "args": ["nodemon@3.1.10", "--version"] },
    { "id": "concurrently-version", "args": ["concurrently@9.2.1", "--version"] },
    { "id": "cross-env-subprocess", "args": ["-p", "cross-env@7.0.3", "cross-env", "FOO=bar", "node", "-e", "console.log(process.env.FOO)"] },
    { "id": "call-lifecycle-event", "args": ["-p", "cowsay@1.6.0", "-c", "node -e \"console.log(process.env.npm_lifecycle_event)\""] },
    { "id": "ni-scoped-multi-bin", "args": ["-p", "@antfu/ni@25.0.0", "ni", "-v"] },
    { "id": "shx-echo", "args": ["-p", "shx@0.4.0", "shx", "echo", "shx-ok"] },
    { "id": "yarn-classic-version", "args": ["yarn@1.22.22", "--version"] },
    { "id": "pnpm-version", "args": ["pnpm@10.18.3", "--version"] },
    { "id": "npm-version", "args": ["npm@11.12.1", "--version"] },
    { "id": "project-bin", "fixture": "project-bin", "args": ["hello-project", "a", "b"] },
    { "id": "local-bin-after-install", "fixture": "local-bin", "setup": "install", "args": ["cowsay", "from-local"] },
    { "id": "local-bin-range-spec", "fixture": "local-bin", "setup": "install", "args": ["cowsay@^1.5.0", "local-range"] },
    { "id": "directory-spec", "args": ["${FIXTURE:project-bin}", "dir-spec"] },
    { "id": "remote-tarball-spec", "args": ["https://registry.npmjs.org/cowsay/-/cowsay-1.5.0.tgz", "tarball"] },
    { "id": "missing-package-exit-code", "args": ["this-package-does-not-exist-oath-exec-parity"], "compare": "status" },
    { "id": "git-spec", "args": ["github:piuccio/cowsay", "git-moo"], "optional": true }
  ]
}
